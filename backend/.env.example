# Database Configuration
DATABASE_URL=postgresql+pg8000://postgres:yourpassword@localhost:5432/doc_scanner_db

# JWT Secret Key - Change this to a random string in production!
JWT_SECRET_KEY=generate-a-secure-random-key-here

# Email Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_DEFAULT_SENDER="DocAction Support <your_email@gmail.com>"

# Base URL for email links (change in production)
BASE_URL=https://api.docaction.com
